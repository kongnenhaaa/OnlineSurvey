@model Survey
@{
    ViewData["Title"] = "Đã gửi khảo sát";
}

<div class="result-state">
    <div class="result-icon result-icon-info">i</div>
    <span class="eyebrow">Khảo sát đã được ghi nhận</span>
    <h1 class="display-6 fw-bold">Bạn đã gửi khảo sát này</h1>
